{
  "name": "@bustit/bot",
  "version": "0.1.0",
  "description": "Plays bustit as a client by basic strategy, to try out tables with several players.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run --passWithNoTests",
    "test:sim": "vitest run --config ./vitest.config.sim.ts"
  },
  "dependencies": {
    "@bustit/engine": "*",
    "@bustit/shared": "*",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
